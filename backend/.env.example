# Django Backend Environment Configuration

SECRET_KEY=django-insecure-qr-attendance-secret-key-2026-super-secure
DEBUG=True

# Database Configuration (SQLite by default, set DB_ENGINE to postgresql for Postgres)
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=attendance_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Django SMTP Email Backend Configuration
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password
DEFAULT_FROM_EMAIL=Campus Attendance System <noreply@school.edu>
